# CFWorkerACME 环境变量模板（Node.js / Docker 自托管模式）
# ---------------------------------------------------------------------------
# 用法：
#   Cloudflare Workers → 不需要这个文件，变量写在 wrangler.jsonc 的 "vars" 里，
#                        或部署后在 CF 控制台 Settings → Variables 里填。
#   Docker / Node.js   → cp .env.example .env 后按需填写；
#                        容器里也可以直接 `-e MAIL_KEYS=xxx`，
#                        或用历史前缀 `-e OPLIST_MAIL_KEYS=xxx`（两者都识别）。
#
# 带 (*) 的是必填，其它按需留空。

# ============================ 数据源 ============================
# 留空或 d1 = Cloudflare D1；mysql = mysql2 直连；prisma = PrismaClient
DB_SOURCE=d1

# DB_SOURCE=mysql 时使用
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASS=
DB_MYSQL_NAME=cfworkeracme
# DB_SOURCE=prisma 时使用
DATABASE_URL=file:./prisma/dev.db

# ============================ 邮件与鉴权 ============================
# (*) Resend API Key，用于发送验证码/通知邮件
MAIL_KEYS=
# (*) 发件人，格式：CFWorkerACME <no-reply@example.com>
MAIL_SEND=
# (*) 站点鉴权盐值，随便一串长随机字符
AUTH_KEYS=
# 站点域名与标题（影响邮件里的链接与页面标题）
SITE_HOST=
SITE_TITLE=CFWorkerACME

# ============================ DCV 自动验证代理 ============================
# (*) 部署在 CF Worker 上的代理地址（域名列表 / 添加 / 删除记录）
DCV_AGENT=
DCV_EMAIL=
DCV_TOKEN=
# (*) 允许托管的根域名列表，逗号分隔，例如 example.com,test.com
DCV_ZONES=

# ============================ CA 厂商 ACME 账号（EAB） ============================
# 每个 CA 一组：useIt=1 表示启用；keyMC=MAC 密钥；keyID=Key ID；KeyTS=Key 生成时间戳
# Google Trust Services
GTS_useIt=0
GTS_keyMC=
GTS_keyID=
GTS_KeyTS=
# SSL.com
SSL_useIt=0
SSL_keyMC=
SSL_keyID=
SSL_KeyTS=
# ZeroSSL
ZRO_useIt=0
ZRO_keyMC=
ZRO_keyID=
ZRO_KeyTS=
